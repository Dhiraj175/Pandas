## Mini-Project: Memory Optimizer
# Scenario: You are a Data Engineer prepping a massive log file for Data Scientists.
# 1. Create a mock DataFrame with 500,000 rows.
# - Column 'User_ID': Integers from 1 to 500000.
# - Column 'Action': Randomly choose between ["Click", "View", "Purchase"].
# - Column 'Score': Random strings of numbers (e.g. "95", "82", "BadData").

user_ID = range(1,500001)
actions = np.random.choice(["Click", "View", "Purchase"],size=500000)
score = np.random.randint(1,101,size=500000).astype("str")
bad_idx = np.random.choice(500000,5000,replace=False)
score[bad_idx] = "BadData"
df = pd.DataFrame({
    "User_ID": user_ID,
    "Action":actions,
    "Score":score
})

# 2. Check the memory usage (df.memory_usage(deep=True).sum() / 1024**2 MB).
memory_usage_beore_otimize = df.memory_usage().sum()/1024**2
print(memory_usage_beore_otimize)

# 3. Convert 'Action' to category.
df["Action"] = df["Action"].astype("category")
print(df.memory_usage().sum()/1024**2)

# 4. Convert 'Score' to numeric using coerce.
df["Score"] = pd.to_numeric(df["Score"],errors="coerce")

# 5. Check memory usage again. Calculate the percentage saved.
memory_usage_after_otimize= df.memory_usage().sum()/1024**2
print(f"Memory Usage: {memory_usage_after_otimize}MB\nSaved memoery: {((memory_usage_beore_otimize-memory_usage_after_otimize)/memory_usage_beore_otimize)*100}")