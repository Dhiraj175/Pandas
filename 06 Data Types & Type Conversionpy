## Exercise 4:
# Write a function optimize_for_ml(df) that:
# 1. Converts all object columns that contain strings to the category dtype.
# 2. Converts all standard int64 and float64 to float32 to save memory for Neural Networks.
def optimize_for_ml(df):
    for col in df.columns:
        if df[col].dtype == "object":
            df[col] = df[col].astype("category")
        elif df[col].dtype in ["int64","float64"]:
            df[col] = df[col].astype("float32")
    return df
